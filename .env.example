# OyunÇöz (.env.example) - Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayın ve gerçek anahtarlarınızı yalnızca .env içine yazın.
# ASLA gerçek anahtarları koda veya git deposuna gömmeyin.

# 1. Yapay Zeka (Gemini API)
GEMINI_API_KEY=

# 2. E-Posta Doğrulama Servisi (SMTP / Resend / Brevo - En az birini yapılandırın)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OyunÇöz Güvenlik <noreply@oyuncoz.com>

# Alternatif HTTP E-Posta API Servisleri (Opsiyonel)
RESEND_API_KEY=
BREVO_API_KEY=

# 3. Oturum ve Güvenlik Ayarları
COOKIE_SECURE=true
ADMIN_SECRET_TOKEN=
ADMIN_API_KEY=

# 4. Arama Motoru Doğrulama Etiketleri (Aşama 7)
GSC_VERIFICATION=
BING_VERIFICATION=

# 5. Çerez Onayına Saygılı Analitik Yapılandırması (plausible | umami | ga4 | none)
ANALYTICS_PROVIDER=none
ANALYTICS_ID=
ANALYTICS_DOMAIN=oyuncoz.com
